[gd_resource type="ShaderMaterial" format=3 uid="uid://ddbh4a6qlcppf"]

[sub_resource type="Shader" id="Shader_outline"]
code = "shader_type spatial;
render_mode unshaded, cull_front, skip_vertex_transform;

uniform vec4 outline_color : source_color = vec4(0.055, 0.035, 0.075, 1.0);
uniform float outline_width = 0.022;

void vertex() {
	// Expand the backfaces in view space so model scale does not change the thickness.
	vec3 view_normal = normalize(MODELVIEW_NORMAL_MATRIX * NORMAL);
	VERTEX = (MODELVIEW_MATRIX * vec4(VERTEX, 1.0)).xyz + view_normal * outline_width;
}

void fragment() {
	ALBEDO = outline_color.rgb;
}"

[resource]
render_priority = 0
shader = SubResource("Shader_outline")
shader_parameter/outline_color = Color(0.055, 0.035, 0.075, 1)
shader_parameter/outline_width = 0.022
